#!/bin/sh
set -e

# Only check if pushing a feature branch, not main itself
CURRENT_BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null || echo "")

if [ -n "$CURRENT_BRANCH" ] && [ "$CURRENT_BRANCH" != "main" ]; then
  echo "🔍 [pre-push] Verifying branch is up-to-date with origin/main..."
  git fetch origin main --quiet 2>/dev/null || true

  BEHIND=$(git rev-list --count HEAD..origin/main 2>/dev/null || echo "0")
  if [ "$BEHIND" -gt 0 ]; then
    echo "❌ [pre-push] Push aborted: '$CURRENT_BRANCH' is behind origin/main by $BEHIND commit(s)!"
    echo "👉 Please update your branch before pushing:"
    echo "   git rebase origin/main"
    exit 1
  fi
  echo "✅ [pre-push] Branch is cleanly rebased on top of origin/main."
fi
