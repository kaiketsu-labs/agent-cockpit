{
  "name": "claude-deck",
  "displayName": "Claude Deck",
  "description": "Claude Code sessions grouped by Jira ticket, with ticket status and open PRs; click a session to attach in a terminal tab.",
  "version": "0.1.0",
  "publisher": "kaiketsu-labs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kaiketsu-labs/claude-deck"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "claudeDeck",
          "title": "Claude Deck",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "claudeDeck": [
        {
          "id": "claudeDeck.sessions",
          "name": "Sessions"
        },
        {
          "id": "claudeDeck.history",
          "name": "History",
          "visibility": "collapsed"
        },
        {
          "id": "claudeDeck.legend",
          "name": "Legend",
          "visibility": "collapsed"
        }
      ]
    },
    "commands": [
      {
        "command": "claudeDeck.refresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "claudeDeck.attach",
        "title": "Attach in terminal"
      },
      {
        "command": "claudeDeck.openJira",
        "title": "Open in Jira",
        "icon": "$(link-external)"
      },
      {
        "command": "claudeDeck.startTask",
        "title": "Start task",
        "icon": "$(add)"
      },
      {
        "command": "claudeDeck.search",
        "title": "Search sessions",
        "icon": "$(search)"
      },
      {
        "command": "claudeDeck.hide",
        "title": "Move to history",
        "icon": "$(archive)"
      },
      {
        "command": "claudeDeck.show",
        "title": "Back to the list",
        "icon": "$(inbox)"
      },
      {
        "command": "claudeDeck.sortAlphabetically",
        "title": "Sort alphabetically",
        "icon": "$(sort-precedence)"
      },
      {
        "command": "claudeDeck.newSession",
        "title": "New session (no ticket)",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "claudeDeck.rename",
        "title": "Rename",
        "icon": "$(edit)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "claudeDeck.startTask",
          "when": "view == claudeDeck.sessions",
          "group": "navigation"
        },
        {
          "command": "claudeDeck.newSession",
          "when": "view == claudeDeck.sessions",
          "group": "navigation"
        },
        {
          "command": "claudeDeck.search",
          "when": "view == claudeDeck.sessions",
          "group": "navigation"
        },
        {
          "command": "claudeDeck.refresh",
          "when": "view == claudeDeck.sessions",
          "group": "navigation"
        },
        {
          "command": "claudeDeck.sortAlphabetically",
          "when": "view == claudeDeck.sessions"
        }
      ],
      "commandPalette": [
        {
          "command": "claudeDeck.attach",
          "when": "false"
        },
        {
          "command": "claudeDeck.openJira",
          "when": "false"
        },
        {
          "command": "claudeDeck.hide",
          "when": "false"
        },
        {
          "command": "claudeDeck.show",
          "when": "false"
        },
        {
          "command": "claudeDeck.rename",
          "when": "false"
        }
      ],
      "view/item/context": [
        {
          "command": "claudeDeck.startTask",
          "when": "view =~ /^claudeDeck\\.(sessions|history)$/ && viewItem == ticket",
          "group": "inline"
        },
        {
          "command": "claudeDeck.openJira",
          "when": "view =~ /^claudeDeck\\.(sessions|history)$/ && viewItem == ticket",
          "group": "inline"
        },
        {
          "command": "claudeDeck.hide",
          "when": "view == claudeDeck.sessions && viewItem == session",
          "group": "inline"
        },
        {
          "command": "claudeDeck.show",
          "when": "view == claudeDeck.history && viewItem == session.hidden",
          "group": "inline"
        },
        {
          "command": "claudeDeck.rename",
          "when": "view =~ /^claudeDeck\\.(sessions|history)$/ && viewItem =~ /^session/",
          "group": "1_edit"
        }
      ]
    }
  }
}
