{
  "name": "agent-cockpit",
  "displayName": "Agent Cockpit",
  "description": "Coding agent sessions organized by project folders and tickets, with live status, ticket status and open PRs; click a session to jump in.",
  "version": "0.5.4",
  "publisher": "kaiketsu-labs",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#18181b",
    "theme": "dark"
  },
  "categories": [
    "Machine Learning",
    "Other"
  ],
  "keywords": [
    "agent",
    "agent cockpit",
    "cockpit",
    "claude",
    "claude code",
    "ai",
    "chat",
    "productivity",
    "terminal",
    "session manager",
    "worktrees",
    "jira",
    "github"
  ],
  "homepage": "https://github.com/kaiketsu-labs/agent-cockpit#readme",
  "bugs": {
    "url": "https://github.com/kaiketsu-labs/agent-cockpit/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kaiketsu-labs/agent-cockpit"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentCockpit",
          "title": "Agent Cockpit",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "agentCockpit": [
        {
          "type": "webview",
          "id": "agentCockpit.inbox",
          "name": "Inbox"
        }
      ]
    },
    "configuration": {
      "title": "Agent Cockpit",
      "properties": {
        "agentCockpit.tracker": {
          "type": "string",
          "enum": [
            "auto",
            "jira",
            "github",
            "command",
            "none"
          ],
          "default": "auto",
          "description": "Issue tracker integration for ticket folders. 'auto' queries Jira for PROJ-123 keys (when JIRA_URL/JIRA_TOKEN are set) and GitHub Issues for #42 / owner/repo#42 keys (when gh is available), without showing error banners when unconfigured."
        },
        "agentCockpit.trackerCommand": {
          "type": "string",
          "default": "",
          "description": "Shell command used when agentCockpit.tracker is 'command'. Receives JSON array of ticket keys on stdin and must print a JSON object mapping keys to { status, category ('new'|'indeterminate'|'done'), summary, url }."
        },
        "agentCockpit.pullRequests": {
          "type": "string",
          "enum": [
            "auto",
            "github",
            "none"
          ],
          "default": "auto",
          "description": "Pull request lookup mode for ticket folders. 'auto' queries GitHub via gh when available and stays silent when unconfigured; 'none' disables PR lookups."
        },
        "agentCockpit.ticketProjects": {
          "type": "string",
          "default": "",
          "description": "Comma-separated project prefixes (e.g. 'PROJ,OPS') to restrict Jira-style ticket recognition. Falls back to TICKET_PROJECTS in settings.json."
        },
        "agentCockpit.ticketPattern": {
          "type": "string",
          "default": "",
          "description": "Optional custom regular expression for matching ticket keys."
        },
        "agentCockpit.githubOrg": {
          "type": "string",
          "default": "",
          "description": "GitHub organization or user scope (e.g. 'kaiketsu-labs') to search for pull requests on Jira ticket folders. When empty, defaults to auto-detected workspace repositories."
        },
        "agentCockpit.githubRepositories": {
          "type": "string",
          "default": "",
          "description": "Comma-separated list of GitHub repositories (e.g. 'org/repo1,org/repo2') to search for pull requests on Jira ticket folders. Overrides auto-detection when set."
        },
        "agentCockpit.closeTerminalOnArchive": {
          "type": "boolean",
          "default": true,
          "description": "Automatically close the associated VS Code terminal tab when archiving a session (moving to history)."
        }
      }
    },
    "commands": [
      {
        "command": "agentCockpit.focus",
        "title": "Focus / Open Session Needing Input",
        "category": "Agent Cockpit"
      },
      {
        "command": "agentCockpit.refresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "agentCockpit.attach",
        "title": "Attach in terminal"
      },
      {
        "command": "agentCockpit.openJira",
        "title": "Open ticket",
        "icon": "$(link-external)"
      },
      {
        "command": "agentCockpit.newSession",
        "title": "New session",
        "icon": "$(add)"
      },
      {
        "command": "agentCockpit.newFolder",
        "title": "New folder or ticket",
        "icon": "$(new-folder)"
      },
      {
        "command": "agentCockpit.renameFolder",
        "title": "Rename folder",
        "icon": "$(edit)"
      },
      {
        "command": "agentCockpit.search",
        "title": "Search sessions",
        "icon": "$(search)"
      },
      {
        "command": "agentCockpit.hide",
        "title": "Move to history",
        "icon": "$(archive)"
      },
      {
        "command": "agentCockpit.show",
        "title": "Back to the list",
        "icon": "$(inbox)"
      },
      {
        "command": "agentCockpit.rename",
        "title": "Rename",
        "icon": "$(edit)"
      },
      {
        "command": "agentCockpit.toggleKeepWarm",
        "title": "Toggle Keep Warm (Prompt Cache Keepalive)",
        "icon": "$(zap)",
        "category": "Agent Cockpit"
      },
      {
        "command": "agentCockpit.configureGithubScope",
        "title": "Configure GitHub PR Scope...",
        "icon": "$(gear)",
        "category": "Agent Cockpit"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "agentCockpit.newSession",
          "when": "view == agentCockpit.inbox",
          "group": "navigation@1"
        },
        {
          "command": "agentCockpit.newFolder",
          "when": "view == agentCockpit.inbox",
          "group": "navigation@2"
        },
        {
          "command": "agentCockpit.refresh",
          "when": "view == agentCockpit.inbox",
          "group": "navigation@3"
        },
        {
          "command": "agentCockpit.configureGithubScope",
          "when": "view == agentCockpit.inbox",
          "group": "navigation@4"
        }
      ],
      "commandPalette": [
        {
          "command": "agentCockpit.attach",
          "when": "false"
        },
        {
          "command": "agentCockpit.openJira",
          "when": "false"
        },
        {
          "command": "agentCockpit.hide",
          "when": "false"
        },
        {
          "command": "agentCockpit.show",
          "when": "false"
        },
        {
          "command": "agentCockpit.rename",
          "when": "false"
        },
        {
          "command": "agentCockpit.renameFolder",
          "when": "false"
        }
      ]
    }
  }
}
