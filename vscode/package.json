{
  "name": "claude-deck",
  "displayName": "Claude Deck",
  "description": "Claude Code sessions organized by project folders and tickets, with live status, ticket status and open PRs; click a session to jump in.",
  "version": "0.4.1",
  "publisher": "kaiketsu-labs",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#18181b",
    "theme": "dark"
  },
  "categories": [
    "AI",
    "Chat",
    "Productivity"
  ],
  "keywords": [
    "claude",
    "claude code",
    "terminal",
    "session manager",
    "worktrees",
    "jira",
    "github"
  ],
  "homepage": "https://github.com/kaiketsu-labs/claude-deck#readme",
  "bugs": {
    "url": "https://github.com/kaiketsu-labs/claude-deck/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kaiketsu-labs/claude-deck"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "claudeDeck",
          "title": "Claude Deck",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "claudeDeck": [
        {
          "type": "webview",
          "id": "claudeDeck.inbox",
          "name": "Inbox"
        }
      ]
    },
    "configuration": {
      "title": "Claude Deck",
      "properties": {
        "claudeDeck.tracker": {
          "type": "string",
          "enum": [
            "auto",
            "jira",
            "github",
            "command",
            "none"
          ],
          "default": "auto",
          "description": "Issue tracker integration for ticket folders. 'auto' queries Jira for PROJ-123 keys (when JIRA_URL/JIRA_TOKEN are set) and GitHub Issues for #42 / owner/repo#42 keys (when gh is available), without showing error banners when unconfigured."
        },
        "claudeDeck.trackerCommand": {
          "type": "string",
          "default": "",
          "description": "Shell command used when claudeDeck.tracker is 'command'. Receives JSON array of ticket keys on stdin and must print a JSON object mapping keys to { status, category ('new'|'indeterminate'|'done'), summary, url }."
        },
        "claudeDeck.pullRequests": {
          "type": "string",
          "enum": [
            "auto",
            "github",
            "none"
          ],
          "default": "auto",
          "description": "Pull request lookup mode for ticket folders. 'auto' queries GitHub via gh when available and stays silent when unconfigured; 'none' disables PR lookups."
        },
        "claudeDeck.ticketProjects": {
          "type": "string",
          "default": "",
          "description": "Comma-separated project prefixes (e.g. 'PROJ,OPS') to restrict Jira-style ticket recognition. Falls back to TICKET_PROJECTS in settings.json."
        },
        "claudeDeck.ticketPattern": {
          "type": "string",
          "default": "",
          "description": "Optional custom regular expression for matching ticket keys."
        }
      }
    },
    "commands": [
      {
        "command": "claudeDeck.focus",
        "title": "Focus / Open Session Needing Input",
        "category": "Claude Deck"
      },
      {
        "command": "claudeDeck.refresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "claudeDeck.attach",
        "title": "Attach in terminal"
      },
      {
        "command": "claudeDeck.openJira",
        "title": "Open ticket",
        "icon": "$(link-external)"
      },
      {
        "command": "claudeDeck.newSession",
        "title": "New session",
        "icon": "$(add)"
      },
      {
        "command": "claudeDeck.newFolder",
        "title": "New folder or ticket",
        "icon": "$(new-folder)"
      },
      {
        "command": "claudeDeck.renameFolder",
        "title": "Rename folder",
        "icon": "$(edit)"
      },
      {
        "command": "claudeDeck.search",
        "title": "Search sessions",
        "icon": "$(search)"
      },
      {
        "command": "claudeDeck.hide",
        "title": "Move to history",
        "icon": "$(archive)"
      },
      {
        "command": "claudeDeck.show",
        "title": "Back to the list",
        "icon": "$(inbox)"
      },
      {
        "command": "claudeDeck.rename",
        "title": "Rename",
        "icon": "$(edit)"
      },
      {
        "command": "claudeDeck.toggleKeepWarm",
        "title": "Toggle Keep Warm (Prompt Cache Keepalive)",
        "icon": "$(zap)",
        "category": "Claude Deck"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "claudeDeck.newSession",
          "when": "view == claudeDeck.inbox",
          "group": "navigation@1"
        },
        {
          "command": "claudeDeck.newFolder",
          "when": "view == claudeDeck.inbox",
          "group": "navigation@2"
        },
        {
          "command": "claudeDeck.refresh",
          "when": "view == claudeDeck.inbox",
          "group": "navigation@3"
        }
      ],
      "commandPalette": [
        {
          "command": "claudeDeck.attach",
          "when": "false"
        },
        {
          "command": "claudeDeck.openJira",
          "when": "false"
        },
        {
          "command": "claudeDeck.hide",
          "when": "false"
        },
        {
          "command": "claudeDeck.show",
          "when": "false"
        },
        {
          "command": "claudeDeck.rename",
          "when": "false"
        },
        {
          "command": "claudeDeck.renameFolder",
          "when": "false"
        }
      ]
    }
  }
}
