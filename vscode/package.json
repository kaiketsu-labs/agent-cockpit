{
  "name": "agent-cockpit",
  "displayName": "Agent Cockpit for Claude Code",
  "description": "Multi-session cockpit for Claude Code in VS Code with prompt cache keepalive, ticket grouping, and PR tracking",
  "version": "1.3.0",
  "publisher": "kaiketsu-labs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kaiketsu-labs/agent-cockpit"
  },
  "bugs": {
    "url": "https://github.com/kaiketsu-labs/agent-cockpit/issues"
  },
  "homepage": "https://github.com/kaiketsu-labs/agent-cockpit#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Productivity",
    "Other"
  ],
  "keywords": [
    "claude",
    "claude code",
    "anthropic",
    "ai assistant",
    "cockpit",
    "agent manager",
    "multi-agent",
    "prompt caching"
  ],
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#1e1e24",
    "theme": "dark"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentCockpit",
          "title": "Agent Cockpit",
          "icon": "icon.svg"
        }
      ]
    },
    "views": {
      "agentCockpit": [
        {
          "type": "webview",
          "id": "agentCockpit.inbox",
          "name": "Sessions"
        }
      ]
    },
    "configuration": {
      "title": "Agent Cockpit",
      "properties": {
        "agentCockpit.tracker": {
          "type": "string",
          "enum": [
            "auto",
            "jira",
            "github",
            "command",
            "none"
          ],
          "default": "auto",
          "description": "How to fetch issue status: 'auto' tries Jira (acli/jira-cli/REST) and GitHub (gh issue view), 'jira' forces Jira, 'github' forces GitHub, 'command' runs agentCockpit.trackerCommand, 'none' disables issue tracking."
        },
        "agentCockpit.trackerCommand": {
          "type": "string",
          "default": "",
          "description": "Shell command to run when tracker is 'command'. Receives a JSON array of keys on stdin and must return JSON mapping each key to { status, category, summary, url }."
        },
        "agentCockpit.pullRequests": {
          "type": "string",
          "enum": [
            "auto",
            "github",
            "none"
          ],
          "default": "auto",
          "description": "Fetch open PRs via GitHub CLI (gh api search/issues) for each active ticket key. 'none' disables PR search."
        },
        "agentCockpit.ticketProjects": {
          "type": "string",
          "default": "",
          "description": "Comma-separated Jira/Linear project prefixes (e.g. 'PROJ,ENG,INFRA') to recognize in branch names, folder names, and prompts. Case-insensitive."
        },
        "agentCockpit.ticketPattern": {
          "type": "string",
          "default": "",
          "description": "Custom regex matching ticket keys (e.g. '[A-Z]{2,10}-\\d+'). Overrides agentCockpit.ticketProjects."
        },
        "agentCockpit.githubOrg": {
          "type": "string",
          "default": "",
          "description": "Optional GitHub organization or username (e.g. 'my-org'). When set, Jira ticket PR searches scope org-wide (org:my-org) across all repositories in that organization."
        },
        "agentCockpit.githubRepositories": {
          "type": "string",
          "default": "",
          "description": "Optional comma-separated list of GitHub repositories (e.g. 'org/repo1, org/repo2'). When set, searches for open PRs are scoped to these repositories instead of guessing from workspace remotes."
        },
        "agentCockpit.closeTerminalOnArchive": {
          "type": "boolean",
          "default": true,
          "description": "Automatically close the session's VS Code terminal tab when moving it to History."
        }
      }
    },
    "commands": [
      {
        "command": "agentCockpit.focus",
        "title": "Focus / Open Session Needing Input",
        "category": "Agent Cockpit"
      },
      {
        "command": "agentCockpit.briefing",
        "title": "Briefing",
        "icon": "$(compass)",
        "category": "Agent Cockpit"
      },
      {
        "command": "agentCockpit.refresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "agentCockpit.attach",
        "title": "Attach in terminal"
      },
      {
        "command": "agentCockpit.openJira",
        "title": "Open ticket",
        "icon": "$(link-external)"
      },
      {
        "command": "agentCockpit.newSession",
        "title": "New session",
        "icon": "$(add)"
      },
      {
        "command": "agentCockpit.newFolder",
        "title": "New folder or ticket",
        "icon": "$(new-folder)"
      },
      {
        "command": "agentCockpit.renameFolder",
        "title": "Rename folder",
        "icon": "$(edit)"
      },
      {
        "command": "agentCockpit.search",
        "title": "Search sessions",
        "icon": "$(search)"
      },
      {
        "command": "agentCockpit.hide",
        "title": "Move to history",
        "icon": "$(archive)"
      },
      {
        "command": "agentCockpit.show",
        "title": "Back to the list",
        "icon": "$(inbox)"
      },
      {
        "command": "agentCockpit.rename",
        "title": "Rename",
        "icon": "$(edit)"
      },
      {
        "command": "agentCockpit.toggleKeepWarm",
        "title": "Toggle Keep Warm (Prompt Cache Keepalive)",
        "icon": "$(zap)",
        "category": "Agent Cockpit"
      },
      {
        "command": "agentCockpit.configureGithubScope",
        "title": "Configure GitHub PR Scope...",
        "icon": "$(gear)",
        "category": "Agent Cockpit"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "agentCockpit.briefing",
          "when": "view == agentCockpit.inbox",
          "group": "navigation@0"
        },
        {
          "command": "agentCockpit.newSession",
          "when": "view == agentCockpit.inbox",
          "group": "navigation@1"
        },
        {
          "command": "agentCockpit.newFolder",
          "when": "view == agentCockpit.inbox",
          "group": "navigation@2"
        },
        {
          "command": "agentCockpit.refresh",
          "when": "view == agentCockpit.inbox",
          "group": "navigation@3"
        },
        {
          "command": "agentCockpit.configureGithubScope",
          "when": "view == agentCockpit.inbox",
          "group": "navigation@4"
        }
      ],
      "commandPalette": [
        {
          "command": "agentCockpit.attach",
          "when": "false"
        },
        {
          "command": "agentCockpit.openJira",
          "when": "false"
        },
        {
          "command": "agentCockpit.renameFolder",
          "when": "false"
        },
        {
          "command": "agentCockpit.hide",
          "when": "false"
        },
        {
          "command": "agentCockpit.show",
          "when": "false"
        },
        {
          "command": "agentCockpit.rename",
          "when": "false"
        }
      ]
    }
  }
}
